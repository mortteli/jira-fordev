{
  "name": "jira-fordev",
  "version": "1.0.0",
  "description": "A CLI tool for interacting with Jira Cloud from the terminal, with Cursor AI integration",
  "main": "./dist/index.js",
  "bin": {
    "jira": "./dist/index.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
