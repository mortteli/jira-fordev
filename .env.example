# Jira Cloud Configuration
# Get your API token from: https://id.atlassian.com/manage-profile/security/api-tokens

# Your Jira Cloud instance URL (e.g., https://your-domain.atlassian.net)
JIRA_HOST=https://your-domain.atlassian.net

# Your Atlassian account email
JIRA_EMAIL=your-email@example.com

# Your Jira API token (NOT your password)
JIRA_API_TOKEN=your-api-token

# ============================================
# Safety Configuration (for AI Agent Usage)
# ============================================

# Require --confirm flag for write operations (create, status, comment, assign)
# Set to 'true' when using with AI agents to prevent accidental bulk operations
# JIRA_REQUIRE_CONFIRMATION=true

# Rate limits per hour (protects against runaway loops)
# JIRA_MAX_CREATES_PER_HOUR=10
# JIRA_MAX_TRANSITIONS_PER_HOUR=20
# JIRA_MAX_COMMENTS_PER_HOUR=30
# JIRA_MAX_ASSIGNS_PER_HOUR=20
